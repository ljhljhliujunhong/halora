{
  "name": "halora",
  "productName": "Halora",
  "version": "0.2.41",
  "private": true,
  "author": "Halora",
  "description": "Halora，自己的 Grok 桌面界面",
  "main": "electron/main.cjs",
  "scripts": {
    "test": "node --test tests/*.cjs",
    "dev": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && node electron/launch.cjs\"",
    "start": "npm run dev",
    "build:ui": "vite build",
    "icon": "node scripts/make-icon.cjs",
    "tidy": "node scripts/tidy-layout.cjs",
    "pack": "npm run icon && npm run build:ui && electron-builder --win dir && node scripts/install-app.cjs"
  },
  "dependencies": {
    "marked": "^15.0.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "electron": "^36.2.1",
    "electron-builder": "^26.0.12",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "vite": "^6.3.5",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "local.halora.app",
    "productName": "Halora",
    "asar": true,
    "directories": {
      "output": "E:/VsCodeProject/Agent缓存文件/halora-release"
    },
    "files": [
      "electron/**/*.cjs",
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "executableName": "Halora",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
